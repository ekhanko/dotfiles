// Settings in here override those in "Default/Preferences.sublime-settings",
// and are overridden in turn by syntax-specific settings.
{
	"color_scheme": "auto",
	"dark_color_scheme": "Alabaster Dark.sublime-color-scheme",
	"light_color_scheme": "Alabaster BG.sublime-color-scheme",
	"theme": "Adaptive.sublime-theme",

	"font_face": "Fira Code",
	"font_options": ["subpixel_antialias", "no_calt"],
	"font_size": 13,

	"tab_size": 2,
	"translate_tabs_to_spaces": true,
	"trim_trailing_white_space_on_save": "not_on_caret",
	"ensure_newline_at_eof_on_save": true,
	"save_on_focus_lost": true,

	"scroll_speed": 0,
	"ignored_packages": ["Vintage",
	],
	"rulers": [120],

	"index_exclude_gitignore": false,

	"enable_tab_scrolling": false,
	"hide_new_tab_button": true,
	"index_files": true,

	"draw_white_space": ["selection", "trailing"],

	"spell_check": true,
	"scroll_past_end": true,

  // MacOS
	"native_tabs": "preferred",
	"hardware_acceleration": "none",
}
